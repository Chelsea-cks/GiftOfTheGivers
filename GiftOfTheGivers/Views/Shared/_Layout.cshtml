<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark main-nav sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">G</span>
                <span><strong>Gift of the Givers</strong><small class="d-block brand-sub">Humanitarian Relief</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Project" asp-action="Index">Relief Projects</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Donation" asp-action="Create">Donate</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Volunteer" asp-action="Create">Volunteer</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Contact" asp-action="Index">Contact</a></li>
                    @if (User.IsInRole("Employee"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    }
                    <li class="nav-item">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                <button class="btn btn-outline-light btn-sm ms-lg-2" type="submit">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-gold btn-sm ms-lg-2" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer class="footer">
    <div class="container py-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-8">
                <strong>Gift of the Givers</strong>
                <div class="small text-white-50">Prototype • Disaster relief coordination platform</div>
            </div>
            <div class="col-md-4 text-md-end small text-white-50">
                © @DateTime.Now.Year Gift of the Givers
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
