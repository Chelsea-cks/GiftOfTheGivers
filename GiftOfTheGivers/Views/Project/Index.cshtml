@model IEnumerable<ReliefProject>
@{
    ViewData["Title"] = "Relief Projects";
}
<section class="page-hero">
    <div class="container py-5">
        <span class="eyebrow">CURRENT OPERATIONS</span>
        <h1 class="text-white fw-bold mt-2">Relief projects</h1>
        <p class="text-white-50 mb-0">Follow active humanitarian projects and operational updates.</p>
    </div>
</section>
<div class="container py-5">
    @foreach (var project in Model)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="badge text-bg-success">@project.Status</span>
                        <h3 class="fw-bold mt-2">@project.ProjectName</h3>
                        <p class="text-muted">@project.Province • @project.DisasterType • Started @project.StartDate.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
                <p>@project.Summary</p>
                <h6 class="fw-bold mt-4">Latest updates</h6>
                @if (!project.Updates.Any())
                {
                    <p class="text-muted">No updates have been posted yet.</p>
                }
                else
                {
                    foreach (var update in project.Updates.OrderByDescending(x => x.UpdateDate))
                    {
                        <div class="update-item"><strong>@update.UpdateDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong><p class="mb-0">@update.UpdateText</p></div>
                    }
                }
                @if (User.IsInRole("Employee"))
                {
                    <form asp-action="AddUpdate" method="post" class="mt-3">
                        <input type="hidden" name="projectId" value="@project.ProjectID" />
                        <div class="input-group">
                            <input name="updateText" class="form-control" placeholder="Post a project update..." />
                            <button class="btn btn-success">Post Update</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</div>
