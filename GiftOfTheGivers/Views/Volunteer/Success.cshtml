@{
    ViewData["Title"] = "Volunteer Registration";
}
<div class="container py-5">
    <div class="certificate-card text-center mx-auto">
        <div class="success-icon">✓</div>
        <h1 class="fw-bold">Registration received</h1>
        <p class="lead text-muted">Thank you for offering your skills.</p>
        <p>Your volunteer profile has been stored for employee review.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-success">Return Home</a>
    </div>
</div>
