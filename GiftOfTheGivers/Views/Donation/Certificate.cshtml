@model Donation
@{
    ViewData["Title"] = "Tax Certificate";
}
<div class="container py-5">
    <div class="tax-paper mx-auto">
        <div class="d-flex justify-content-between align-items-start">
            <div><div class="brand-mark mb-2">G</div><h2 class="fw-bold">Gift of the Givers</h2><p class="text-muted">Humanitarian Relief Foundation</p></div>
            <span class="badge bg-success">PROTOTYPE</span>
        </div>
        <hr />
        <h3 class="text-center my-4">DONATION TAX CERTIFICATE</h3>
        <p>This on-screen certificate confirms that a donation record was captured by the prototype system.</p>
        <table class="table table-bordered mt-4">
            <tr><th>Certificate number</th><td>@Model.TaxCertificate?.CertificateNumber</td></tr>
            <tr><th>Donation reference</th><td>#@Model.DonationID</td></tr>
            <tr><th>Donation date</th><td>@Model.DonationDate.ToLocalTime().ToString("dd MMMM yyyy")</td></tr>
            <tr><th>Amount</th><td>@Model.Currency @Model.Amount.ToString("N2")</td></tr>
            <tr><th>Donation type</th><td>@Model.DonationType</td></tr>
        </table>
        <div class="alert alert-light border mt-4">Prototype notice: this document is not a legally valid tax certificate and is included to demonstrate the required workflow.</div>
        <div class="text-center mt-4"><button onclick="window.print()" class="btn btn-success">Print / Save as PDF</button></div>
    </div>
</div>
